<Window
    x:Class="FrameVault.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FrameVault V1.0.0">
    <Grid x:Name="MainRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                      HorizontalContentAlignment="Stretch">
            <StackPanel Padding="28" Spacing="12" MaxWidth="920" HorizontalAlignment="Center">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="FrameVault V1.0.0" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <ToggleSwitch x:Name="ThemeToggle" Grid.Column="1" Header="화면 테마"
                          OffContent="화이트" OnContent="다크"
                          VerticalAlignment="Center" Toggled="ThemeToggle_Toggled" />
        </Grid>
        <TextBlock Text="USB 카메라, 메모리카드 또는 폴더의 사진과 영상을 안전하게 증분 백업합니다." TextWrapping="Wrap" />
        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="안정적인 네트워크 권장" Message="대용량 사진과 영상의 안전한 백업을 위해 연결이 안정적인 네트워크 환경에서 작업하는 것을 권장합니다." />

        <TextBlock Text="백업 대상 프로필 (최대 4개)" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox x:Name="ProfileBox" Width="260" PlaceholderText="프로필 선택" SelectionChanged="ProfileBox_SelectionChanged" />
            <TextBox x:Name="ProfileNameBox" Width="220" PlaceholderText="프로필 이름" />
            <Button Content="프로필 저장" Click="SaveProfile_Click" />
            <Button Content="프로필 삭제" Click="DeleteProfile_Click" />
        </StackPanel>

        <TextBlock Text="원본" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="SourceFolderBox" Width="535" PlaceholderText="USB 카메라 자동 탐색 또는 폴더 선택" TextChanged="SourceFolderBox_TextChanged" />
            <Button x:Name="DetectButton" Content="자동 탐색" Click="AutoDetect_Click" />
            <Button x:Name="PickSourceButton" Content="폴더 선택" Click="PickFolder_Click" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12">
            <CheckBox x:Name="AutoDetectCheckBox" Content="5초마다 새 카메라나 카드 연결을 감지" IsChecked="True" VerticalAlignment="Center" />
            <Button x:Name="CameraInfoButton" Content="카메라 정보" Click="CameraInfo_Click" />
        </StackPanel>
        <TextBlock Text="촬영 기간 (비워 두면 전체 기간)" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <CalendarDatePicker x:Name="TakenFromPicker" Width="220" PlaceholderText="시작일" DateChanged="TakenDate_Changed" />
            <TextBlock Text="~" VerticalAlignment="Center" />
            <CalendarDatePicker x:Name="TakenToPicker" Width="220" PlaceholderText="종료일" DateChanged="TakenDate_Changed" />
        </StackPanel>

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                BorderThickness="2" CornerRadius="10" Padding="16" Margin="0,8,0,4">
            <StackPanel Spacing="8">
                <TextBlock Text="백업 대상 종류" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="파일을 저장할 방식을 선택하세요. 이 선택에 따라 아래 연결 설정이 달라집니다."
                           Opacity="0.8" TextWrapping="Wrap" />
                <ComboBox x:Name="ProtocolBox" Header="저장 방식" SelectedIndex="1"
                          SelectionChanged="ProtocolBox_SelectionChanged" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="로컬 폴더 / 외장 드라이브" Tag="Local" />
                    <ComboBoxItem Content="SMB 네트워크 공유" Tag="Smb" />
                    <ComboBoxItem Content="HTTPS WebDAV" Tag="WebDav" />
                </ComboBox>
            </StackPanel>
        </Border>
        <TextBlock x:Name="EndpointLabel" Text="백업 대상 루트 — SMB 공유 경로" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="EndpointBox" Width="650" PlaceholderText="예: \\diskstation\photo" TextChanged="DestinationPath_Changed" />
            <Button x:Name="PickDestinationButton" Content="경로 선택" Click="PickDestination_Click" />
        </StackPanel>
        <StackPanel x:Name="CredentialsPanel" Spacing="8">
            <TextBlock Text="대상 전용 계정" /><TextBox x:Name="UserBox" TextChanged="DestinationCredentials_Changed" />
            <TextBlock Text="비밀번호 (Windows DPAPI로 암호화)" /><PasswordBox x:Name="PasswordBox" PasswordChanged="DestinationCredentials_Changed" />
        </StackPanel>

        <StackPanel x:Name="DestinationFolderPanel" Spacing="8">
            <TextBlock Text="원격 백업 하위 폴더" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="LibraryBox" Width="610" IsReadOnly="True" PlaceholderText="대상에 연결한 뒤 폴더를 선택하세요" TextChanged="DestinationPath_Changed" />
                <Button x:Name="BrowseDestinationButton" Content="연결 후 폴더 선택" Click="BrowseDestination_Click" />
            </StackPanel>
        </StackPanel>
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
            <StackPanel Spacing="4"><TextBlock Text="실제 사진 저장 경로 예시" FontWeight="SemiBold" /><TextBlock x:Name="DestinationPreviewText" Text="대상 폴더를 선택하세요." TextWrapping="Wrap" /></StackPanel>
        </Border>

        <TextBlock Text="원격 검증" />
        <ComboBox x:Name="VerificationBox" SelectedIndex="0">
            <ComboBoxItem Content="표준 — 파일 크기 확인" Tag="Size" />
            <ComboBoxItem Content="정밀 — 원격 파일 SHA-256 재검증" Tag="Sha256" />
        </ComboBox>
        <TextBlock Text="자동백업 임시파일 경로" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="CacheFolderBox" Width="460" PlaceholderText="%LOCALAPPDATA%\FrameVault\WpdCache" />
            <Button x:Name="ClearCacheButton" Content="임시 파일 삭제" Click="ClearCache_Click" />
            <Button x:Name="OpenCacheButton" Content="캐시 폴더 열기" Click="OpenCache_Click" />
        </StackPanel>
        <TextBlock Text="캐시 최대 용량 (GB)" Visibility="Collapsed" />
        <NumberBox x:Name="CacheLimitBox" Visibility="Collapsed" Value="50" Minimum="1" Maximum="2048" SpinButtonPlacementMode="Compact" />

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="TestButton" Content="연결 시험" Click="TestConnection_Click" />
            <Button x:Name="BackupButton" Content="새 파일 백업" Click="Backup_Click" Style="{StaticResource AccentButtonStyle}" />
            <Button x:Name="IntegrityButton" Content="전체 무결성 검사" Click="IntegrityCheck_Click" />
            <Button x:Name="CancelButton" Content="취소" Click="Cancel_Click" IsEnabled="False" />
        </StackPanel>
        <StackPanel Spacing="4">
            <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0" Height="18" />
            <TextBlock x:Name="ProgressText" Text="0%" HorizontalAlignment="Center" FontWeight="SemiBold" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Text="준비됨" TextWrapping="Wrap" />
        <ListView x:Name="FilesList" Height="300" />
            </StackPanel>
        </ScrollViewer>
        <Border x:Name="ThemeFadeOverlay" Background="Transparent" Opacity="0"
                IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
    </Grid>
</Window>




